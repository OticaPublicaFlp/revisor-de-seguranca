# Configuração do revisor de segurança.
# O jeito mais fácil de preencher é rodar `check configurar`, que pergunta tudo e valida cada chave.
# Este arquivo é só o modelo: a configuração real fica em .env (fora do git, com permissão 600).

# --- Projeto ---
# Pasta em profiles/ com o contexto e as regras do seu projeto ("exemplo" vem pronto para teste)
PROFILE=exemplo

# --- Repositório (acesso SOMENTE LEITURA) ---
REPO_URL=https://github.com/sua-empresa/seu-projeto.git
REPO_BRANCH=main
# Token do GitHub só de leitura (fine-grained, permissão Contents: Read). Vazio = credencial do git deste PC.
REPO_TOKEN=
# Ou: caminho da chave privada de uma deploy key só de leitura (use REPO_URL no formato git@github.com:...)
REPO_SSH_KEY=

# --- Modo de revisão ---
# code = lê o código atual da branch, por partes (padrão) · diff = só o que mudou desde a última execução
REVIEW_MODE=code
# Quantas partes revisar por execução (a base inteira é coberta aos poucos)
MAX_UNITS=5
# Revisa de novo uma parte sem alteração depois de N dias
RECHECK_DAYS=30

# --- Agendamento (check run) ---
# Cron de 5 campos: minuto hora dia mês dia-da-semana. Padrão: todo dia às 8h
CRON_EXPR=0 8 * * *
TZ=America/Sao_Paulo
# Modo diff: na primeira execução, revisa os últimos N commits
INITIAL_LOOKBACK_COMMITS=20

# --- Inteligência artificial (Anthropic) ---
ANTHROPIC_API_KEY=
REVIEW_MODEL=claude-opus-5-5
# Esforço: low | medium | high | xhigh | max (mais esforço = mais profundo e mais caro)
EFFORT=medium
# Segunda revisão com olhar de atacante: off | critical (funções, migrations e temas) | all
DUAL_REVIEW=critical
# Etapa que tenta refutar cada achado antes de reportar (menos alarme falso)
VERIFY=true
# Consulta bibliotecas com falhas conhecidas no osv.dev (envia só nome e versão dos pacotes)
DEPS_CHECK=true
# Limites técnicos (raramente precisam mudar)
MAX_TURNS=14
MAX_OUTPUT_TOKENS=32000
CHUNK_CHARS=60000
MAX_CHUNKS=6

# --- Telegram (onde chegam os relatórios) ---
TELEGRAM_BOT_TOKEN=
# Conversa que recebe os relatórios (grupo = número negativo). `check configurar` descobre sozinho.
TELEGRAM_CHAT_ID=
# Opcional: só estes IDs podem aprovar o envio ao Slack (vazio = qualquer membro do grupo)
TELEGRAM_APPROVER_IDS=

# --- Slack (opcional; só recebe o que for aprovado no Telegram) ---
SLACK_BOT_TOKEN=
# ID do canal (ex.: C0123456789), não o nome
SLACK_CHANNEL_ID=
# false = o Slack recebe só severidade, título e arquivo (sem descrição)
SLACK_INCLUDE_DETAILS=false

# --- Estado local ---
DATA_DIR=./data
